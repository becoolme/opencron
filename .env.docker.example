# Copy to .env next to docker-compose.yml and replace every value.
# Generate secrets with: openssl rand -hex 32

# Password for the bundled PostgreSQL
POSTGRES_PASSWORD=change-me-postgres-password
# Signs session cookies; at least 16 random characters
BETTER_AUTH_SECRET=change-me-auth-secret
# Shared secret between the app and the script sandbox; at least 16 random characters
SANDBOX_TOKEN=change-me-sandbox-token
# The public address users open, used for sign-in redirects and links
APP_URL=http://localhost:8080
# Host port for the app
OPENCRON_PORT=8080
# Allow URL jobs to reach private and loopback addresses (true/false)
ALLOW_PRIVATE_TARGETS=false

# Script sandbox
# Scripts running at the same time; further runs queue
SANDBOX_CONCURRENCY=4
# Docker runtime for script containers, e.g. runsc for gVisor (recommended when installed)
SANDBOX_DOCKER_RUNTIME=
# Docker network for script containers; "none" means no network access at all
SANDBOX_NETWORK=none
# Images for each runtime; they are pulled when the sandbox starts
SANDBOX_IMAGE_NODE=node:22-alpine
SANDBOX_IMAGE_PYTHON=python:3.12-alpine
SANDBOX_IMAGE_GO=golang:1.23-alpine
