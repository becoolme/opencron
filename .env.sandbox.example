# Copy to .env.sandbox next to docker-compose.sandbox.yml and replace every value.
# Generate secrets with: openssl rand -hex 32

# Shared secret between the Worker and the sandbox; the same value goes into `wrangler secret put SANDBOX_TOKEN`.
# At least 16 random characters
SANDBOX_TOKEN=change-me-sandbox-token
# Token of the Cloudflare Tunnel that publishes the sandbox (Zero Trust > Networks > Tunnels)
TUNNEL_TOKEN=change-me-tunnel-token

# Scripts running at the same time; further runs queue
SANDBOX_CONCURRENCY=4
# How many of those one account may use; empty means half of SANDBOX_CONCURRENCY
SANDBOX_OWNER_CONCURRENCY=
# Docker runtime for script containers, e.g. runsc for gVisor (recommended when installed)
SANDBOX_DOCKER_RUNTIME=
# Docker network for script containers; "none" means no network access at all
SANDBOX_NETWORK=none
# Images for each runtime, pulled when the sandbox starts. Empty means the images pinned by digest in
# apps/sandbox/src/docker-args.mjs; if you set one, pin it too (name:tag@sha256:...)
SANDBOX_IMAGE_NODE=
SANDBOX_IMAGE_PYTHON=
SANDBOX_IMAGE_GO=
