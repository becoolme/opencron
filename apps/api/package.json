{
  "name": "@opencron/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init:local": "wrangler d1 execute DB --local --file=./migrations/0001_init.sql",
    "db:init:remote": "wrangler d1 execute DB --remote --file=./migrations/0001_init.sql",
    "db:migrate:local:0002": "wrangler d1 execute DB --local --file=./migrations/0002_script_jobs.sql",
    "db:migrate:remote:0002": "wrangler d1 execute DB --remote --file=./migrations/0002_script_jobs.sql",
    "db:migrate:local:0003": "wrangler d1 execute DB --local --file=./migrations/0003_notify.sql",
    "db:migrate:remote:0003": "wrangler d1 execute DB --remote --file=./migrations/0003_notify.sql",
    "db:migrate:local:0004": "wrangler d1 execute DB --local --file=./migrations/0004_better_auth.sql",
    "db:migrate:remote:0004": "wrangler d1 execute DB --remote --file=./migrations/0004_better_auth.sql",
    "db:migrate:local:0005": "wrangler d1 execute DB --local --file=./migrations/0005_script_sandbox.sql",
    "db:migrate:remote:0005": "wrangler d1 execute DB --remote --file=./migrations/0005_script_sandbox.sql",
    "db:migrate:postgres": "tsx scripts/migrate-postgres.ts",
    "db:migrate:local:0006": "wrangler d1 execute DB --local --file=./migrations/0006_script_tables.sql",
    "db:migrate:remote:0006": "wrangler d1 execute DB --remote --file=./migrations/0006_script_tables.sql",
    "db:migrate:local:0007": "wrangler d1 execute DB --local --file=./migrations/0007_script_runtime.sql",
    "db:migrate:remote:0007": "wrangler d1 execute DB --remote --file=./migrations/0007_script_runtime.sql",
    "db:migrate:local:0008": "wrangler d1 execute DB --local --file=./migrations/0008_secrets.sql",
    "db:migrate:remote:0008": "wrangler d1 execute DB --remote --file=./migrations/0008_secrets.sql",
    "db:migrate:local:0009": "wrangler d1 execute DB --local --file=./migrations/0009_api_keys.sql",
    "db:migrate:remote:0009": "wrangler d1 execute DB --remote --file=./migrations/0009_api_keys.sql",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "test:smoke": "tsx scripts/smoke-database.ts",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "build:node": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.mjs --external:pg-native --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "start:node": "node dist/server.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@openuptime/kit": "workspace:*",
    "@openuptime/mcp-rest": "workspace:*",
    "better-auth": "1.7.1",
    "cron-parser": "^4.9.0",
    "hono": "^4.6.0",
    "pg": "^8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vitest": "~2.1.0",
    "wrangler": "^4.125.0"
  }
}
