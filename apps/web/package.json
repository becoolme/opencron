{
  "name": "@opencron/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy --config dist/opencron/wrangler.json",
    "dev:postgres": "OPENCRON_CONFIG=../api/wrangler.postgres.toml vite dev",
    "build:postgres": "OPENCRON_CONFIG=../api/wrangler.postgres.toml vite build",
    "deploy:postgres": "OPENCRON_CONFIG=../api/wrangler.postgres.toml vite build && wrangler deploy --config dist/opencron/wrangler.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "better-auth": "1.7.1",
    "codemirror": "6.0.2",
    "cron-parser": "4.9.0",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@opencron/api": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.8",
    "tailwindcss": "4.3.3",
    "typescript": "^5.5.0",
    "vite": "8.2.2",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.11",
    "wrangler": "^4.125.0"
  }
}
