          <div class="code">
            <div class="code-head"><span class="mono">main.js</span><span class="mono dim">JavaScript</span></div>
            <pre class="mono"><span class="cm">// Count the runs of this job in its own KV store</span>
export default &#123;
  async fetch(request, env) &#123;
    const &#123; jobName, scheduledAt &#125; = await request.json();
    const runs = Number((await env.KV.get("runs")) ?? 0) + 1;
    await env.KV.put("runs", String(runs));
    return new Response(`$&#123;jobName&#125;: run $&#123;runs&#125; at $&#123;scheduledAt&#125;`);
  &#125;,
&#125;;</pre>
            <div class="mono code-out"><div class="dim">{c.scripts.runNote}</div><div>nightly-report: run 42 at 2026-11-07T03:00:00.000Z</div><div class="green">← 200 OK</div></div>
          </div>
        </div>
