---
import Base from "../layouts/Base.astro";
import "../landing/landing.css";
---

<Base locale="en" title="Page not found · OpenCron" path="/404" noindex>
  <main class="oc" style="min-height: 100vh; display: grid; place-items: center; text-align: center; padding: 32px">
    <div>
      <p class="mono faint">404</p>
      <h1 class="serif" style="font-size: 56px; line-height: 1.05; margin-top: 8px">This page does not exist</h1>
      <p class="muted" style="margin-top: 12px">The address may be mistyped, or the page has moved.</p>
      <div class="actions center">
        <a class="btn primary" href="/">Go to the home page</a>
        <a class="btn" href="/app">Open the app</a>
      </div>
    </div>
  </main>
</Base>
